// The Cloudflare Worker that serves ahmedkhaleel.com (built by OpenNext).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "cloudflare-worker.mjs",
  "account_id": "8a4f309f2639721dc9f4f0d1790fd6d5",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Also keeps the Worker reachable at its workers.dev address for testing.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio",
    },
  ],
  // Resizes the project preview pictures (next/image).
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
